{
  "name": "unplugin-compdi",
  "version": "0.11.0",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    "./rollup": {
      "types": "./dist/rollup.d.mts",
      "import": "./dist/rollup.mjs"
    },
    "./rolldown": {
      "types": "./dist/rolldown.d.mts",
      "import": "./dist/rolldown.mjs"
    },
    "./rspack": {
      "types": "./dist/rspack.d.mts",
      "import": "./dist/rspack.mjs"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.mts",
      "import": "./dist/esbuild.mjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/franz-bendezu/compdi.git"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "echo 'No lint rules configured for unplugin-compdi'",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "clean": "rm -rf dist",
    "release:verify": "pnpm pack --dry-run --json > /dev/null",
    "release": "pnpm publish",
    "release:dry-run": "pnpm publish --dry-run",
    "release:ci": "pnpm publish --provenance"
  },
  "dependencies": {
    "magic-string": "^0.30.11",
    "oxc-parser": "^0.142.0",
    "unplugin": "^3.2.0"
  },
  "devDependencies": {
    "@compdi/core": "workspace:^",
    "@rspack/cli": "^2.1.7",
    "@rspack/core": "^2.1.7",
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "rolldown": "^1.2.1",
    "rollup": "^4.62.4",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.9"
  }
}
