{
  "name": "@compdi/shared",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "dev": "tsdown src/index.ts --format esm --dts --watch",
    "lint": "echo 'No lint rules configured for @compdi/shared'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo 'No tests for @compdi/shared'",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsdown": "^0.22.0",
    "typescript": "^5.6.3"
  }
}
