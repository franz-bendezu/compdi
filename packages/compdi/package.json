{
  "name": "compdi",
  "version": "0.4.0",
  "type": "module",
  "description": "Compdi DI runtime and compiler - complete package",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./macros": "./dist/macros.mjs",
    "./plugin": "./dist/plugin.mjs",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/franz-bendezu/compdi.git"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "echo 'No lint rules configured for compdi'",
    "typecheck": "tsc --noEmit",
    "test": "echo 'No tests for compdi'",
    "clean": "rm -rf dist",
    "release:verify": "npm pack --dry-run --json > /dev/null",
    "release": "npm publish",
    "release:dry-run": "npm publish --dry-run",
    "release:ci": "npm publish --provenance"
  },
  "dependencies": {
    "@compdi/core": "*",
    "unplugin-compdi": "*"
  },
  "devDependencies": {
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3"
  }
}
