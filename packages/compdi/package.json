{
  "name": "compdi",
  "version": "0.11.0",
  "type": "module",
  "description": "Compdi DI runtime and compiler - complete package",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./macros": "./dist/macros.mjs",
    "./plugin": "./dist/plugin/index.mjs",
    "./plugin/esbuild": "./dist/plugin/esbuild.mjs",
    "./plugin/rolldown": "./dist/plugin/rolldown.mjs",
    "./plugin/rollup": "./dist/plugin/rollup.mjs",
    "./plugin/rspack": "./dist/plugin/rspack.mjs",
    "./plugin/vite": "./dist/plugin/vite.mjs",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/franz-bendezu/compdi.git"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "echo 'No lint rules configured for compdi'",
    "typecheck": "tsc --noEmit",
    "test": "echo 'No tests for compdi'",
    "clean": "rm -rf dist",
    "release:verify": "pnpm pack --dry-run --json > /dev/null",
    "release": "pnpm publish",
    "release:dry-run": "pnpm publish --dry-run",
    "release:ci": "pnpm publish --provenance"
  },
  "dependencies": {
    "@compdi/core": "workspace:^",
    "unplugin-compdi": "workspace:^"
  },
  "devDependencies": {
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}
