{
  "name": "@compdi/core",
  "version": "0.6.0",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/franz-bendezu/compdi.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "echo 'No lint rules configured for @compdi/core'",
    "typecheck": "tsc --noEmit",
    "test": "echo 'No tests for @compdi/core'",
    "clean": "rm -rf dist",
    "release:verify": "pnpm pack --dry-run --json > /dev/null",
    "release": "pnpm publish",
    "release:dry-run": "pnpm publish --dry-run",
    "release:ci": "pnpm publish --provenance"
  },
  "devDependencies": {
    "tsdown": "^0.22.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
