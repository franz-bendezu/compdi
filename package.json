{
  "name": "compdi-monorepo",
  "version": "0.4.0",
  "private": true,
  "description": "Compdi monorepo powered by Turborepo",
  "license": "MIT",
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "packages/*",
    "playground"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "test": "turbo run test",
    "publish:verify": "turbo run release:verify",
    "publish:core": "turbo run release --filter=@compdi/core",
    "publish:unplugin": "turbo run release --filter=unplugin-compdi",
    "publish:compdi": "turbo run release --filter=compdi",
    "publish:ci": "turbo run release:ci",
    "publish:dry-run": "turbo run release:dry-run",
    "publish:local": "turbo run release"
  },
  "devDependencies": {
    "turbo": "^2.0.14",
    "typescript": "^6.0.3"
  }
}
